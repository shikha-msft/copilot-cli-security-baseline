{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Shell(sudo *)",
      "Shell(su *)",
      "Shell(doas *)",
      "Shell(pkexec *)",
      "Shell(mkfs *)",
      "Shell(dd *)",
      "Shell(diskpart *)",
      "Shell(gh auth token *)",
      "Shell(az account get-access-token *)",
      "Shell(gcloud auth print-access-token *)",
      "Shell(security find-generic-password *)",
      "Shell(security find-internet-password *)",
      "PowerShell(Invoke-Expression *)",
      "PowerShell(iex *)",
      "PowerShell(Set-ExecutionPolicy *)",
      "PowerShell(Set-MpPreference *)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Edit(/**/.env)",
      "Edit(/**/.env.*)",
      "Edit(//etc/**)",
      "Edit(//etc/github-copilot/**)",
      "Edit(//opt/github-copilot-policy/**)",
      "Edit(//Library/Application Support/GitHubCopilot/**)"
    ],
    "ask": [
      "Shell(rm -rf *)",
      "Shell(rm -fr *)",
      "Shell(git push *)",
      "Shell(npm publish *)",
      "Shell(crontab *)",
      "Shell(ssh *)",
      "Shell(scp *)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.profile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.gitconfig)"
    ],
    "allow": [
      "Shell(git status *)",
      "Shell(git diff *)",
      "Shell(git log *)",
      "Shell(git add *)",
      "Shell(git commit *)",
      "Shell(git fetch *)",
      "Shell(git pull *)",
      "Shell(git checkout *)",
      "Shell(git branch *)",
      "Shell(npm test *)",
      "Shell(npm run *)",
      "Shell(npm ci *)",
      "Shell(npm install *)",
      "Shell(pytest *)",
      "Shell(python -m pytest *)",
      "Shell(dotnet build *)",
      "Shell(dotnet test *)",
      "Shell(mvn *)",
      "Shell(gradle *)",
      "Shell(go build *)",
      "Shell(go test *)",
      "Shell(cat *)",
      "Shell(ls *)",
      "Shell(head *)",
      "Shell(tail *)",
      "Shell(grep *)",
      "Shell(rg *)",
      "Shell(find *)",
      "Shell(echo *)",
      "Shell(pwd)",
      "Shell(which *)",
      "Read(./**)",
      "Edit(./**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowBypass": false,
    "sandboxMcpServers": true,
    "sandboxLspServers": true
  },
  "remoteControl": {
    "mode": "disabled"
  },
  "allowedMcpServers": []
}
